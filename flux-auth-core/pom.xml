<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.flux</groupId>
        <artifactId>flux-auth-center</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>flux-auth-core</artifactId>
    <packaging>jar</packaging>
    <name>flux-auth-core</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- 统一响应、错误码、常量 -->
        <dependency>
            <groupId>com.flux</groupId>
            <artifactId>common-core</artifactId>
        </dependency>

        <!-- web：Controller、BizException、参数校验 -->
        <dependency>
            <groupId>com.flux</groupId>
            <artifactId>common-web</artifactId>
        </dependency>

        <!-- 登录态：LoginService / LoginHelper / LoginUser -->
        <dependency>
            <groupId>com.flux</groupId>
            <artifactId>common-satoken</artifactId>
        </dependency>

        <!-- 登录事件 -->
        <dependency>
            <groupId>com.flux</groupId>
            <artifactId>common-log</artifactId>
        </dependency>

        <!-- DataScopeEnum：多角色数据范围合并 -->
        <dependency>
            <groupId>com.flux</groupId>
            <artifactId>common-mybatis-plus</artifactId>
        </dependency>

        <!-- 用户/角色/权限/部门查询 -->
        <dependency>
            <groupId>com.flux</groupId>
            <artifactId>flux-auth-system</artifactId>
        </dependency>

        <!-- lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
