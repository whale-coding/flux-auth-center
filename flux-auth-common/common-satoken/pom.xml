<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.flux</groupId>
        <artifactId>flux-auth-common</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>common-satoken</artifactId>
    <packaging>jar</packaging>
    <name>common-satoken</name>

    <description>认证封装：登录状态、权限校验、防重复提交</description>

    <dependencies>
        <!-- common-core -->
        <dependency>
            <groupId>com.flux</groupId>
            <artifactId>common-core</artifactId>
        </dependency>

        <!-- common-web：全局异常、BizException -->
        <dependency>
            <groupId>com.flux</groupId>
            <artifactId>common-web</artifactId>
        </dependency>

        <!-- common-redis：RedissonClient，防重复提交用它做分布式占位 -->
        <dependency>
            <groupId>com.flux</groupId>
            <artifactId>common-redis</artifactId>
        </dependency>

        <!-- sa-token -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot4-starter</artifactId>
        </dependency>

        <!--
            sa-token 的 Redis 持久层。
            Spring Boot 4 用的是 Jackson 3，所以必须配 sa-token-jackson3；
            根 pom 里声明的 sa-token-redis-jackson 是 Jackson 2 的聚合包，在 Boot 4 下不适用。
        -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-template</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-jackson3</artifactId>
        </dependency>

        <!-- 接口文档注解：只给 LoginUser 加字段说明，optional 不向使用方传递依赖 -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- aop：防重复提交切面 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <!-- lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- 处理 Spring Boot 配置文件的注解（AuthProperties） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
